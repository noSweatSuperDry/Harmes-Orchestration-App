{
  "_comment": [
    "Copy to ~/.hermes-orchestrator/config.json, or set HERMES_ORCHESTRATOR_CONFIG",
    "to point somewhere else. The app writes this file too, so anything you add",
    "by hand shows up in the UI and vice versa.",
    "",
    "This file NEVER contains passwords or key material. Key hosts store the PATH",
    "to a private key; password hosts store only whether a password was saved to",
    "your OS keychain. It does name your servers -- keep it out of public repos."
  ],
  "defaults": {
    "username": "your-ssh-user",
    "privateKeyPath": "~/.ssh/id_ed25519",
    "port": 22,
    "profile": "default",
    "hermesHome": "",
    "auth": "key"
  },
  "ui": {
    "motion": "always"
  },
  "hosts": [
    {
      "id": "prod-1",
      "label": "Production",
      "hostname": "prod.example.com",
      "port": 22,
      "username": "your-ssh-user",
      "privateKeyPath": "~/.ssh/id_ed25519",
      "hermesHome": "",
      "defaultProfile": "default",
      "auth": "key"
    },
    {
      "id": "dev-1",
      "label": "Dev box",
      "hostname": "10.0.0.42",
      "port": 2222,
      "username": "ubuntu",
      "privateKeyPath": "~/.ssh/id_dev",
      "hermesHome": "/opt/hermes",
      "defaultProfile": "staging",
      "auth": "key"
    },
    {
      "id": "local-1",
      "label": "Local VPS",
      "hostname": "192.168.1.50",
      "port": 22,
      "username": "ubuntu",
      "auth": "password",
      "savePassword": true,
      "privateKeyPath": "",
      "hermesHome": "",
      "defaultProfile": "default"
    }
  ]
}
